# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=researchhub

# Long random secret for sign-in sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Your administrator account (created automatically on the first start only)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Your Name

# Optional: turn on AI briefings and document reading (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max size per uploaded file, in MB
MAX_UPLOAD_MB=25
# Use NODE_ENV=production when hosted on HTTPS (secure cookies)
NODE_ENV=development
